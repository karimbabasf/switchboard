/**
 * Renders the recording disclosure to a file, once, so the phone line plays it
 * instead of synthesizing it on every call.
 *
 *   pnpm opener:render
 *
 * WHY THERE IS A SCRIPT FOR THIS. The opener is the same words in the same voice
 * on every single call, and `speak` re-rendered it every time. Measured on two
 * real calls from telnyx_events: 1.72s and 2.04s between `call.answered` and
 * `call.speak.started`, which the caller hears as dead air after pickup. A file
 * Telnyx has already fetched starts playing without that step.
 *
 * THE OUTPUT FILE IS NAMED AFTER ITS OWN CONTENT. `openerFingerprint()` hashes
 * the three things that decide what the audio sounds like: the text, the voice,
 * and the speed. Change any one of them and the runtime asks for a URL that does
 * not exist yet, falls back to `speak`, and a test fails until this is re-run.
 * That is the whole reason the name is derived rather than configured: a
 * pre-rendered legal notice that keeps playing after the wording changed is
 * worse than a slow one, and it would fail silently.
 *
 * Re-run this whenever OPENER, TELNYX_TTS or TELNYX_VOICE_SPEED change. Commit
 * the mp3: it is served as a static asset off our own deployment, which is where
 * Telnyx fetches it from.
 */
import { mkdir, readdir, unlink, writeFile } from 'node:fs/promises';

import { openerFilePath, openerFingerprint, openerText } from '../lib/telnyx/opener.ts';
import { agentVoice, voiceSpeed } from '../lib/telnyx/assistant.ts';
import { env } from '../lib/env.ts';

const OUT_DIR = 'public/opener';

const voice = agentVoice();
const speed = voiceSpeed();
const text = openerText();
const path = openerFilePath();

console.log('\nOpener render');
console.log(`  voice  ${voice}`);
console.log(`  speed  ${speed}`);
console.log(`  text   ${JSON.stringify(text)}`);
console.log(`  file   ${path}\n`);

const res = await fetch('https://api.telnyx.com/v2/text-to-speech/speech', {
  method: 'POST',
  headers: {
    authorization: `Bearer ${env('TELNYX_API_KEY')}`,
    'content-type': 'application/json',
  },
  // Nested under voice_settings, never top level: measured on 2026-08-14, a
  // top-level voice_speed is accepted and changes the audio not at all.
  body: JSON.stringify({ voice, text, voice_settings: { voice_speed: speed } }),
});

if (!res.ok) {
  const detail = await res.text().catch(() => '');
  console.error(`\nFAILED ${res.status} ${detail.slice(0, 300)}`);
  if (res.status === 400 && /not found/i.test(detail)) {
    console.error('\nThat usually means the voice id no longer exists. Telnyx deleted the whole');
    console.error('NaturalHD tier without notice on 2026-08-18. Check GET /v2/text-to-speech/voices.');
  }
  process.exit(1);
}

const audio = Buffer.from(await res.arrayBuffer());
await mkdir(OUT_DIR, { recursive: true });
await writeFile(path, audio);

// Every other rendering is now unreachable: nothing addresses it, and leaving it
// in the repo invites somebody to point at the wrong one by hand.
const keep = `${openerFingerprint()}.mp3`;
for (const name of await readdir(OUT_DIR)) {
  if (name !== keep && name.endsWith('.mp3')) {
    await unlink(`${OUT_DIR}/${name}`);
    console.log(`  removed stale ${name}`);
  }
}

// The runtime reads THIS, not a hash recomputed from its own environment. See
// the note above the export in opener.ts: TELNYX_TTS is a production variable
// that cannot be read back, so a fingerprint computed on Vercel could name a
// file that was never rendered, and the fallback would hide it.
await writeFile(
  'lib/telnyx/opener-build.ts',
  `// GENERATED BY pnpm opener:render. Do not edit by hand.
//
// This is the disclosure that was actually rendered, and the runtime plays the
// file this names. Editing OPENER, TELNYX_TTS or TELNYX_VOICE_SPEED without
// re-running the script fails tests/opener.test.ts rather than going quiet.
export const OPENER_BUILD = {
  fingerprint: ${JSON.stringify(openerFingerprint())},
  voice: ${JSON.stringify(voice)},
  speed: ${JSON.stringify(speed)},
  text: ${JSON.stringify(text)},
} as const;
`,
);

const kb = (audio.length / 1024).toFixed(1);
console.log(`  wrote ${path} (${kb} KB)`);
console.log('  wrote lib/telnyx/opener-build.ts');
console.log('\nCommit the file. It is served from public/ and Telnyx fetches it once per cache miss.');
console.log('Then deploy, or the URL the call asks for will not exist yet.\n');
