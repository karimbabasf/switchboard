# Copy to .env.local and fill in. .env.local is gitignored and never leaves this machine.
# Run `pnpm preflight` after filling these to confirm every credential is live.

# --- Telnyx ---------------------------------------------------------------
# Portal: API Keys (v2). Secret, full account access.
TELNYX_API_KEY=
# Portal: Account > Keys. Used to verify inbound webhook signatures (Ed25519).
TELNYX_PUBLIC_KEY=
# Call Control application id. Inbound calls to the number are routed to it.
TELNYX_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=
# The number itself, E.164.
TELNYX_NUMBER=
# Your real cell. Inbound calls bridge here after the disclosure plays.
FORWARD_TO_NUMBER=
# LEAVE THIS BLANK. The default is OPENER in lib/agent/brief.ts, which is where
# everything a caller hears now lives, next to the greeting it runs into and the
# tests that check the pair. Set it only to reword the line without a deploy.
#
# This is beat 1 of the opener and it carries THREE things: who is talking, that
# the call is recorded, and that the caller is talking to a machine. California
# is all-party consent (Penal Code 632), so the recording notice is not optional
# and not a formality, and `record_start` does not fire until this has finished
# playing. Keep it plain and audible.
#
# The introduction is in THIS half, not the greeting, because this is the only
# half that can start the instant we answer. Beat 2 waits on this speak ending,
# a webhook round trip, the recording, the assistant booting and the caller
# context, which is why "Hi, this is Robin" used to land five seconds in.
# Read the two beats together out loud, they are one script:
#   "Hi, this is Robin from Acme USA. We supply packing materials. I'm an
#    automated assistant, and this call is recorded. How can I help you today?"
# The company is named ONCE across the two. Naming it in both is what made the
# line sound like two systems talking, and a test asserts it appears once.
RECORDING_DISCLOSURE=
# There is no separate TELNYX_VOICE any more. It used to set the disclosure voice
# on its own and defaulted to "female", Telnyx's legacy basic engine, so callers
# heard a robot read the legal notice and then a different, human-sounding voice
# say hello. One voice now, TELNYX_TTS below, read by both.

# --- Voice agent ----------------------------------------------------------
# Printed by `pnpm assistant:sync` on the first run. With it set, later runs
# update that assistant; without it, sync finds one by name before creating.
TELNYX_ASSISTANT_ID=
# The origin Telnyx can reach: the tunnel host in dev, the deployment in prod.
# The agent's tools and its caller-context webhook are built from this, so a
# stale value means every tool call 404s while the assistant still answers.
PUBLIC_BASE_URL=
# Random 32+ chars. Sent as X-Agent-Secret on every tool and context call and
# checked on the way in. Separate from WORKER_SECRET on purpose: this one is
# stored inside Telnyx's config, so it leaks by a different route.
AGENT_TOOL_SECRET=
# THE voice on this line. The agent, the recording disclosure and the voicemail
# prompt all read it from here, so they cannot end up being different people.
# Format is <Provider>.<Model>.<VoiceId>, and the id must exist in
# GET /v2/text-to-speech/voices:
#   Telnyx.NaturalHD.luna             the default, set in lib/telnyx/assistant.ts
#   Telnyx.NaturalHD.astra            second Rime Arcana read
#   Telnyx.Ultra.<uuid>               Ultra ids are UUIDs, never the docs' names
#   AWS.Polly.Joanna-Neural           neural Polly
#   Azure.en-US-BrianMultilingualNeural
#   ElevenLabs.eleven_multilingual_v2.<voiceId>   needs your own ElevenLabs key
#     supplied via voice_settings.api_key_ref, not this variable
# NOT Telnyx.Bayan.*: that is the Arabic model with English speakers bolted on,
# and it ran this line until 2026-08-14 because it was half the bake-off sheet.
# Chosen by listening to candidates on a real call, never from a list, and LEAVE
# THIS BLANK once one wins: a voice pinned here beats the code default silently.
TELNYX_TTS=
# How fast that voice talks. 1 is its natural pace, below 1 is slower. The code
# default is 1, and it should stay near 1. It is a multiplier on a pace each
# voice picks for itself, so it does NOT carry across a voice change. A big
# stretch is audible: the previous voice needed 0.70 to hit the target pace and
# Karim heard the result as "down-pitched, as if the voice were slowed down", with the
# pitch measured flat, so what he heard was 30 percent of time stretch. If you
# find yourself far from 1, the voice is wrong, not the number. Pick one whose
# natural pace is already right and leave this alone.
TELNYX_VOICE_SPEED=
# Speech to text. deepgram/flux is a turn-taking model: it does recognition and
# end-of-turn together, which is what keeps the agent from talking over people.
TELNYX_STT=
# The conversational model. Native Telnyx models need no external key and add no
# network hop, which is why the default is one. NEAR AI Cloud is the standing
# default everywhere latency is free; on a live call it has to earn it, so it is
# measured against this before it replaces it.
#
# LEAVE THIS BLANK unless you are running a bake-off. The code default is
# anthropic/claude-haiku-4-5 and a test pins it. This was set to
# moonshotai/Kimi-K2.6 in one .env.local and nowhere else, so the assistant that
# actually answered the phone was not the one the repo described or the one
# `pnpm rehearse` scored. Kimi is tuned to sound conversational and it does it by
# performing hesitation: "uhm", trailing off, run-on sentences. On a supply
# company's phone line that reads as unprofessional, not as human (Karim,
# 2026-08-11). Instruction-following beats naturalness here.
TELNYX_LLM_MODEL=

# --- Telegram -------------------------------------------------------------
# BotFather token. Also set /setprivacy to Disable or the bot cannot see replies.
TELEGRAM_BOT_TOKEN=
# The one supergroup. Negative number, starts with -100. Every update from any
# other chat is dropped.
TELEGRAM_CHAT_ID=
# Random 32+ chars. Passed to setWebhook, arrives back in the
# X-Telegram-Bot-Api-Secret-Token header. Telegram publishes no IP ranges, so
# this plus the chat_id filter is the entire door.
TELEGRAM_WEBHOOK_SECRET=

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=recordings

# --- Transcription and summaries -----------------------------------------
# AssemblyAI over Deepgram: native multichannel at $0.15/hr (Universal-2) or
# $0.21/hr (Universal-3.5 Pro), both under Deepgram's ~$0.26/hr. Recordings are
# dual-channel, so each party is already isolated and diarization is not needed.
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal-3-5-pro
# NEAR AI Cloud is the default provider for every LLM call in Karim's projects.
# OpenAI-compatible, same endpoint the Akme email classifier already runs on.
# Pick the model per task on cost against quality: this one is structured
# extraction from a short transcript, not reasoning, so the cheap tier is right.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=openai/gpt-oss-120b

# --- QuickBooks mirror (OFF by default, see below) ------------------------
# Leave this false until Karim decides deliberately. Intuit rotates the refresh
# token on EVERY use, so the store below is shared with Akme and a bug here
# does not degrade switchboard, it kills Akme's ability to invoice anyone.
QBO_SYNC_ENABLED=false
# MUST point at the same project holding Akme's token store. Two stores fighting
# over one rotating refresh token invalidate the Intuit connection within a day.
QBO_TOKEN_SUPABASE_URL=
QBO_TOKEN_SUPABASE_SERVICE_ROLE_KEY=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_ENV=sandbox
QBO_MINOR_VERSION=75

# --- Internal -------------------------------------------------------------
# Authenticates the pg_cron sweep calling /api/worker. Deliberately SEPARATE from
# every other secret: one leaking must not hand over anything else.
WORKER_SECRET=
