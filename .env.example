# Copy to .env.local and fill in. .env.local is gitignored and never leaves this machine.
# Run `pnpm preflight` after filling these to confirm every credential is live.

# --- Telnyx ---------------------------------------------------------------
# Portal: API Keys (v2). Secret, full account access.
TELNYX_API_KEY=
# Portal: Account > Keys. Used to verify inbound webhook signatures (Ed25519).
TELNYX_PUBLIC_KEY=
# Call Control application id. Inbound calls to the number are routed to it.
TELNYX_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=
# The number itself, E.164.
TELNYX_NUMBER=
# Your real cell. Inbound calls bridge here after the disclosure plays.
FORWARD_TO_NUMBER=
# Spoken before recording starts. California is all-party consent, so this is
# not optional and not a formality. Keep it plain and audible.
RECORDING_DISCLOSURE="This call is being recorded."

# --- Telegram -------------------------------------------------------------
# BotFather token. Also set /setprivacy to Disable or the bot cannot see replies.
TELEGRAM_BOT_TOKEN=
# The one supergroup. Negative number, starts with -100. Every update from any
# other chat is dropped.
TELEGRAM_CHAT_ID=
# Random 32+ chars. Passed to setWebhook, arrives back in the
# X-Telegram-Bot-Api-Secret-Token header. Telegram publishes no IP ranges, so
# this plus the chat_id filter is the entire door.
TELEGRAM_WEBHOOK_SECRET=

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=recordings

# --- Transcription and summaries -----------------------------------------
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# --- Internal -------------------------------------------------------------
# Authenticates the pg_cron sweep calling /api/worker. Deliberately SEPARATE from
# every other secret: one leaking must not hand over anything else.
WORKER_SECRET=
